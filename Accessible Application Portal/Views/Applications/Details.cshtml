@model Application
@{
    ViewData["Title"] = "Application details";
}

<h1>Application details</h1>

<dl class="row application-details">
    <dt class="col-sm-4 col-lg-3">Application ID</dt>
    <dd class="col-sm-8 col-lg-9">@Model.ApplicationId</dd>

    <dt class="col-sm-4 col-lg-3">Applicant name</dt>
    <dd class="col-sm-8 col-lg-9">@Model.ApplicantName</dd>

    <dt class="col-sm-4 col-lg-3">Submitted date</dt>
    <dd class="col-sm-8 col-lg-9">@Model.SubmittedDate.ToString("MMMM d, yyyy")</dd>

    <dt class="col-sm-4 col-lg-3">Status</dt>
    <dd class="col-sm-8 col-lg-9">@Model.Status</dd>

    <dt class="col-sm-4 col-lg-3">Application type</dt>
    <dd class="col-sm-8 col-lg-9">@Model.ApplicationType</dd>

    <dt class="col-sm-4 col-lg-3">Email</dt>
    <dd class="col-sm-8 col-lg-9"><a href="mailto:@Model.Email">@Model.Email</a></dd>

    <dt class="col-sm-4 col-lg-3">Phone number</dt>
    <dd class="col-sm-8 col-lg-9"><a href="tel:@Model.PhoneNumber">@Model.PhoneNumber</a></dd>

    <dt class="col-sm-4 col-lg-3">Comments</dt>
    <dd class="col-sm-8 col-lg-9">@(string.IsNullOrWhiteSpace(Model.Comments) ? "None provided" : Model.Comments)</dd>
</dl>

<a class="btn btn-secondary" asp-action="Index">Back to applications</a>
