@model IReadOnlyList<Application>
@{
    ViewData["Title"] = "Applications";
    var searchTerm = ViewBag.SearchTerm as string ?? string.Empty;
    var selectedStatus = ViewBag.SelectedStatus as string ?? string.Empty;
    var statuses = ViewBag.Statuses as IEnumerable<string> ?? Array.Empty<string>();
}

<h1>Applications</h1>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="status" aria-live="polite">
        @successMessage
    </div>
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <p class="mb-0">Review submitted applications or create a new application.</p>
    <a class="btn btn-primary" asp-action="Create">New Application</a>
</div>

<form method="get" asp-action="Index" class="row g-3 align-items-end mb-4">
    <div class="col-12 col-md-5">
        <label for="search-term" class="form-label">Search by application ID or applicant name</label>
        <input id="search-term" name="searchTerm" value="@searchTerm" class="form-control" />
    </div>
    <div class="col-12 col-md-4">
        <label for="status-filter" class="form-label">Status</label>
        <select id="status-filter" name="status" class="form-select">
            <option value="">All statuses</option>
            @foreach (var availableStatus in statuses)
            {
                <option value="@availableStatus" selected="@(string.Equals(selectedStatus, availableStatus, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">
                    @availableStatus
                </option>
            }
        </select>
    </div>
    <div class="col-12 col-md-auto">
        <button type="submit" class="btn btn-secondary">Apply filters</button>
        <a class="btn btn-link" asp-action="Index">Clear</a>
    </div>
</form>

<p class="mb-2">@Model.Count application(s) found.</p>

@if (Model.Count == 0)
{
    <p>No applications match your search.</p>
}
else
{
    <div class="table-responsive" role="region" tabindex="0" aria-label="Application results. Scroll horizontally if needed.">
        <table class="table table-striped table-hover align-middle">
            <caption class="visually-hidden">Application records</caption>
            <thead>
                <tr>
                    <th scope="col">Application ID</th>
                    <th scope="col">Applicant Name</th>
                    <th scope="col">Submitted Date</th>
                    <th scope="col">Status</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var application in Model)
                {
                    <tr>
                        <td>@application.ApplicationId</td>
                        <td>@application.ApplicantName</td>
                        <td>@application.SubmittedDate.ToString("MMM d, yyyy")</td>
                        <td>@application.Status</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@application.ApplicationId">
                                View details<span class="visually-hidden"> for @application.ApplicantName</span>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
