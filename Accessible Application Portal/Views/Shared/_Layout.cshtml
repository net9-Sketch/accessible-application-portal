<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Accessible Application Portal</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom mb-4" aria-label="Main navigation">
            <div class="container">
                <a class="navbar-brand" asp-controller="Applications" asp-action="Index">Accessible Application Portal</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#main-navigation"
                        aria-controls="main-navigation" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse" id="main-navigation">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Applications" asp-action="Index">Applications</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Applications" asp-action="Create">New Application</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main id="main-content" class="container pb-4" tabindex="-1">
        @RenderBody()
    </main>

    <footer class="border-top mt-4 py-3 text-muted">
        <div class="container">
            Independent sample project using fictional data.
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
